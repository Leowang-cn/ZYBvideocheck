[Unit]
Description=Video Review Service
After=network.target

[Service]
Type=simple
User=video-review
Group=video-review
WorkingDirectory=/opt/video-review
EnvironmentFile=/etc/video-review/server.env
ExecStart=/opt/video-review/.venv/bin/uvicorn server.app:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target