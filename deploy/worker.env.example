# 复制到服务器 /etc/video-review/worker.env，并执行 chmod 600。
OPENLIST_URL=http://127.0.0.1:5244
OPENLIST_TOKEN=请替换为OpenList访问Token
OPENLIST_PATH=/baidu-test
BAIDU_PAN_MOUNT_PATH=/baidu-test

COS_BUCKET=请替换为目标桶
COS_REGION=ap-beijing
COS_PREFIX=0leoshare/videocheck
COS_PUBLIC_BASE_URL=https://目标桶.cos.ap-beijing.myqcloud.com
COS_SECRET_ID=请替换为新SecretId
COS_SECRET_KEY=请替换为新SecretKey

VIDEO_REVIEW_SERVER_URL=http://127.0.0.1:8901
VIDEO_REVIEW_IMPORT_TOKEN=请替换为服务端IMPORT_TOKEN

INPUT_DIR=/data/deploys/video-review/待处理视频
OUTPUT_DIR=/data/deploys/video-review/输出
DATA_DIR=/data/deploys/video-review/数据